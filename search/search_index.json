{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u10d4\u10da\u10d4\u10e5\u10e2\u10e0\u10e3\u10da\u10d8 \u10ec\u10e0\u10d4\u10d3\u10d4\u10d1\u10d8","text":""},{"location":"#_2","title":"\u10e0\u10d4\u10e1\u10e3\u10e0\u10e1\u10d4\u10d1\u10d8","text":"<ul> <li>\ud83d\udcda Fundamentals of Electric Circuits \u2014 Charles Alexander, Matthew Sadiku</li> <li>\u2705 Fundamentals of Electric Circuits \u2014 \u10d0\u10db\u10dd\u10ee\u10e1\u10dc\u10d4\u10d1\u10d8</li> <li>\ud83e\uddea Multisim \u2014 \u10ec\u10e0\u10d4\u10d3\u10d4\u10d1\u10d8\u10e1 \u10e1\u10d8\u10db\u10e3\u10da\u10d8\u10e0\u10d4\u10d1\u10d0</li> </ul>"},{"location":"#5","title":"\u10da\u10d4\u10e5\u10ea\u10d8\u10d0 5 \u2014 \u10ec\u10e0\u10d4\u10d3\u10d4\u10d1\u10d8\u10e1 \u10d7\u10d4\u10dd\u10e0\u10d4\u10db\u10d4\u10d1\u10d8: \u10dc\u10dd\u10e0\u10e2\u10dd\u10dc\u10d8\u10e1 \u10d7\u10d4\u10dd\u10e0\u10d4\u10db\u10d0","text":"<ul> <li>\ud83d\udda5\ufe0f \u10da\u10d4\u10e5\u10ea\u10d8\u10d8\u10e1 \u10e1\u10e5\u10e0\u10d8\u10dc\u10d8</li> <li>\ud83d\udcdd \u10d3\u10d0\u10d5\u10d0\u10da\u10d4\u10d1\u10d0: \u10ec\u10d0\u10d8\u10d9\u10d8\u10d7\u10ee\u10d4\u10d7 \u10d7\u10d0\u10d5\u10d4\u10d1\u10d8 4.6, 4.7 \u10d3\u10d0 4.8.</li> <li>\ud83d\udcdd \u10d0\u10db\u10dd\u10ee\u10e1\u10d4\u10dc\u10d8\u10d7 \u10d0\u10db\u10dd\u10ea\u10d0\u10dc\u10d4\u10d1\u10d8: \u10d7\u10d0\u10d5\u10d8 4 \u2014 44, 47, 48, 56, 57, 60, 63, 64, 71, 72;</li> <li>\ud83d\udcda \u10ec\u10d8\u10dc\u10d0 \u10ec\u10da\u10d8\u10e1 \u10e8\u10e3\u10d0\u10da\u10d4\u10d3\u10e3\u10e0\u10d8</li> </ul>"},{"location":"#4","title":"\u10da\u10d4\u10e5\u10ea\u10d8\u10d0 4 \u2014 \u10ec\u10e0\u10d4\u10d3\u10d4\u10d1\u10d8\u10e1 \u10d7\u10d4\u10dd\u10e0\u10d4\u10db\u10d4\u10d1\u10d8: \u10ec\u10e0\u10e4\u10d8\u10d5\u10dd\u10d1\u10d0, \u10e1\u10e3\u10de\u10d4\u10e0\u10de\u10dd\u10d6\u10d8\u10ea\u10d8\u10d0 \u10d3\u10d0 \u10d7\u10d4\u10d5\u10d4\u10dc\u10d8\u10dc\u10d8\u10e1 \u10d7\u10d4\u10dd\u10e0\u10d4\u10db\u10d0","text":"<ul> <li>\ud83d\udda5\ufe0f \u10da\u10d4\u10e5\u10ea\u10d8\u10d8\u10e1 \u10e1\u10e5\u10e0\u10d8\u10dc\u10d8</li> <li>\ud83d\udcdd \u10d3\u10d0\u10d5\u10d0\u10da\u10d4\u10d1\u10d0: \u10ec\u10d0\u10d8\u10d9\u10d8\u10d7\u10ee\u10d4\u10d7 \u10d7\u10d0\u10d5\u10d4\u10d1\u10d8 4.1, 4.2, 4.3, 4.4 \u10d3\u10d0 4.5.</li> <li>\ud83d\udcdd \u10d0\u10db\u10dd\u10ee\u10e1\u10d4\u10dc\u10d8\u10d7 \u10d0\u10db\u10dd\u10ea\u10d0\u10dc\u10d4\u10d1\u10d8: \u10d7\u10d0\u10d5\u10d8 4 \u2014 3, 11, 12, 15, 19, 26, 30, 33, 36, 38, 40, 42, 45;</li> </ul>"},{"location":"#3-mesh-analysis","title":"\u10da\u10d4\u10e5\u10ea\u10d8\u10d0 3 \u2014 Mesh Analysis","text":"<ul> <li>\ud83d\udda5\ufe0f \u10da\u10d4\u10e5\u10ea\u10d8\u10d8\u10e1 \u10e1\u10e5\u10e0\u10d8\u10dc\u10d8</li> <li>\ud83d\udcdd \u10d3\u10d0\u10d5\u10d0\u10da\u10d4\u10d1\u10d0: \u10ec\u10d0\u10d8\u10d9\u10d8\u10d7\u10ee\u10d4\u10d7 \u10d7\u10d0\u10d5\u10d4\u10d1\u10d8 3.4, 3.5, 3.6 \u10d3\u10d0 3.7.</li> <li>\ud83d\udcdd \u10d0\u10db\u10dd\u10ee\u10e1\u10d4\u10dc\u10d8\u10d7 \u10d0\u10db\u10dd\u10ea\u10d0\u10dc\u10d4\u10d1\u10d8: \u10d7\u10d0\u10d5\u10d8 3 \u2014 41, 43, 44, 50, 58, 61, 64, 66, 67, 70, 72, 74;</li> </ul>"},{"location":"#2-nodal-analysis","title":"\u10da\u10d4\u10e5\u10ea\u10d8\u10d0 2 \u2014 Nodal Analysis","text":"<ul> <li>\ud83d\udda5\ufe0f \u10da\u10d4\u10e5\u10ea\u10d8\u10d8\u10e1 \u10e1\u10e5\u10e0\u10d8\u10dc\u10d8</li> <li>\ud83d\udcdd \u10d3\u10d0\u10d5\u10d0\u10da\u10d4\u10d1\u10d0: \u10ec\u10d0\u10d8\u10d9\u10d8\u10d7\u10ee\u10d4\u10d7 \u10d7\u10d0\u10d5\u10d4\u10d1\u10d8 3.1, 3.2 \u10d3\u10d0 3.3.</li> <li>\ud83d\udcdd \u10d0\u10db\u10dd\u10ee\u10e1\u10d4\u10dc\u10d8\u10d7 \u10d0\u10db\u10dd\u10ea\u10d0\u10dc\u10d4\u10d1\u10d8: \u10d7\u10d0\u10d5\u10d8 3 \u2014 2, 3, 5, 6, 8, 9, 10, 12, 15, 16, 18, 22, 25, 30, 31, 32;</li> </ul>"},{"location":"#1","title":"\u10da\u10d4\u10e5\u10ea\u10d8\u10d0 1 \u2014 \u10e8\u10d4\u10e1\u10d0\u10d5\u10d0\u10da\u10d8 \u10d4\u10da\u10d4\u10e5\u10e2\u10e0\u10e3\u10da \u10ec\u10e0\u10d4\u10d3\u10d4\u10d1\u10e8\u10d8: \u10db\u10e3\u10ee\u10e2\u10d8, \u10d3\u10d4\u10dc\u10d8, \u10eb\u10d0\u10d1\u10d5\u10d0. \u10dd\u10db\u10d8\u10e1 \u10d9\u10d0\u10dc\u10dd\u10dc\u10d8. \u10d9\u10d8\u10e0\u10f0\u10dd\u10e4\u10d8\u10e1 \u10d9\u10d0\u10dc\u10dd\u10dc\u10d8. \u10de\u10d0\u10e0\u10d0\u10da\u10d4\u10da\u10e3\u10e0\u10d8 \u10d3\u10d0 \u10db\u10d8\u10db\u10d3\u10d4\u10d5\u10e0\u10dd\u10d1\u10d8\u10d7\u10d8 \u10e9\u10d0\u10e0\u10d7\u10d5\u10d4\u10d1\u10d8","text":"<ul> <li>\ud83d\udda5\ufe0f \u10da\u10d4\u10e5\u10ea\u10d8\u10d8\u10e1 \u10e1\u10e5\u10e0\u10d8\u10dc\u10d8</li> <li>\ud83d\udcdd \u10d3\u10d0\u10d5\u10d0\u10da\u10d4\u10d1\u10d0: \u10ec\u10d0\u10d8\u10d9\u10d8\u10d7\u10ee\u10d4\u10d7 \u10d7\u10d0\u10d5\u10d4\u10d1\u10d8 1 \u10d3\u10d0 2.</li> <li>\ud83d\udcdd \u10d0\u10db\u10dd\u10ee\u10e1\u10d4\u10dc\u10d8\u10d7 \u10d0\u10db\u10dd\u10ea\u10d0\u10dc\u10d4\u10d1\u10d8:</li> <li>\u10d7\u10d0\u10d5\u10d8 1 \u2014 7, 8, 14, 15, 20, 23, 27;</li> <li>\u10d7\u10d0\u10d5\u10d8 2 \u2014 4, 7, 12, 13, 14, 15, 16, 20, 21, 26, 32, 33, 37.</li> </ul>"}]}